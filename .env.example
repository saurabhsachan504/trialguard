# ---------------------------------------------------------------------------
# Copy to .env and fill in. NEVER commit the real .env.
# Generate secrets with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# ---------------------------------------------------------------------------

ENV=dev                       # dev | test | prod
DEBUG=true
APP_NAME=TrialGuard API
APP_BASE_URL=http://localhost:8000

# --- database --------------------------------------------------------------
# dev
DATABASE_URL=sqlite:///./trialguard.db
# prod
# DATABASE_URL=postgresql+psycopg://trialguard:password@db:5432/trialguard

# --- secrets (MUST be changed for production) ------------------------------
SECRET_KEY=change-me-to-a-long-random-string
# Peppers the device fingerprint before it is stored. Changing this later
# resets every device ledger, so set it once and keep it safe.
DEVICE_HASH_SECRET=change-me-to-a-different-long-random-string
ADMIN_API_KEY=

ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# --- trial policy ----------------------------------------------------------
FREE_TRIAL_LIMIT=5
ENFORCE_DEVICE_TRIAL_LIMIT=true
# Coarse hardware-only ledger. Survives "clear extension storage", but has
# lower entropy, so give it a looser cap than FREE_TRIAL_LIMIT.
ENFORCE_MACHINE_TRIAL_LIMIT=true
MACHINE_TRIAL_LIMIT=15
MAX_ACCOUNTS_PER_DEVICE=3
MAX_DEVICES_PER_FREE_USER=2
MAX_DEVICES_PER_PAID_USER=5
REQUIRE_EMAIL_VERIFICATION=false

# --- billing ---------------------------------------------------------------
PAYMENT_PROVIDER=mock         # mock | stripe | razorpay
# Required to enable the fake checkout/webhook used for local testing.
# Leave EMPTY in any deployment that is reachable from the internet.
MOCK_BILLING_SECRET=local-dev-mock-secret
PLAN_PRICE_CENTS=500
PLAN_CURRENCY=USD
PLAN_INTERVAL=month
BILLING_SUCCESS_URL=https://yourdomain.com/billing/success
BILLING_CANCEL_URL=https://yourdomain.com/billing/cancel

# Stripe
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=              # optional; omit to build the $5/mo price inline
STRIPE_WEBHOOK_SECRET=

# Razorpay (use this if you bill from an Indian entity)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_PLAN_ID=
RAZORPAY_WEBHOOK_SECRET=

# --- web app / summarisation ------------------------------------------------
WEB_APP_ENABLED=true

# Your Ollama server (the same one the Chrome extension uses)
OLLAMA_URL=https://ollama.trueworks.in
OLLAMA_MODEL=gemma2:9b
# Regional Indian languages (Marathi, Gujarati, Tamil, Telugu, Kannada,
# Malayalam, Bengali, Punjabi, Urdu...) are routed here - general models drift
# back into English on those.
OLLAMA_INDIC_MODEL=sarvam-m-q4
OLLAMA_TIMEOUT_SECONDS=300

# Long transcripts are sampled down to this budget before summarising.
# Applies to the on-screen SUMMARY only - the full notes always read all of it.
TRANSCRIPT_MAX_CHARS=12000

# --- full notes (the PDF) ---------------------------------------------------
# Smaller chunks = less compression = more detail survives.
NOTES_CHUNK_CHARS=3500
NOTES_CHUNK_OVERLAP=400
# 0 = no limit, so a 3-hour video is still covered end to end. Any value above
# 0 truncates long videos (and the user is told when it happens).
NOTES_MAX_CHUNKS=0
NOTES_NUM_PREDICT=4096
# Chunks sent to Ollama at once. Raise to 3-4 only if your Ollama has
# OLLAMA_NUM_PARALLEL set higher than 1.
NOTES_CONCURRENCY=2
NOTES_CHUNK_RETRIES=3
# Set this if YouTube starts blocking your server's IP (datacenter IPs get
# throttled). Example: http://user:pass@proxy-host:port
YOUTUBE_PROXY=

# --- transport -------------------------------------------------------------
# Lock this down to your extension once you know its id:
# ALLOWED_ORIGINS=chrome-extension://abcdefghijklmnopabcdefghijklmnop
ALLOWED_ORIGINS=*

# Set to true ONLY when the app sits behind a reverse proxy you control that
# overwrites X-Forwarded-For. Otherwise clients can spoof their IP past the
# rate limiter.
TRUST_PROXY_HEADERS=false

# --- rate limiting ---------------------------------------------------------
RATE_LIMIT_ENABLED=true
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_SECONDS=300
SIGNUP_RATE_LIMIT=5
SIGNUP_RATE_WINDOW_SECONDS=3600

# --- email -----------------------------------------------------------------
EMAIL_BACKEND=console         # console | smtp
EMAIL_FROM=no-reply@yourdomain.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
