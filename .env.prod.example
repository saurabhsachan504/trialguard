# ===========================================================================
# PRODUCTION .env  ->  DGX par isko  .env  naam se save karo
#
#   cp .env.prod.example .env
#   nano .env            # neeche wale <FILL> bharo
#
# Ye file GitHub par kabhi mat daalo.
# ===========================================================================

ENV=prod
DEBUG=false
APP_NAME=TubeNotes API
APP_BASE_URL=https://tubenotes.trueworks.in

# --- database --------------------------------------------------------------
# DATABASE_URL docker-compose.prod.yml khud set karta hai (db service ka
# hostname "db" hai). Yahan sirf password chahiye - dono jagah yahi use hota hai.
POSTGRES_PASSWORD=<FILL: openssl rand -hex 24>

# --- secrets ---------------------------------------------------------------
# Dono alag-alag hone chahiye. Banane ke liye:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=<FILL>
# DHYAN: ye badalne par har device ka trial ledger reset ho jata hai
# (fingerprint isi se hash hota hai). Ek baar set karo, phir kabhi mat badlo.
DEVICE_HASH_SECRET=<FILL: alag wala>
# /admin routes ke liye. Khali chhodoge to admin endpoints band rahenge.
ADMIN_API_KEY=<FILL>

ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# --- trial policy ----------------------------------------------------------
FREE_TRIAL_LIMIT=5
ENFORCE_DEVICE_TRIAL_LIMIT=true
ENFORCE_MACHINE_TRIAL_LIMIT=true
MACHINE_TRIAL_LIMIT=15
MAX_ACCOUNTS_PER_DEVICE=3
MAX_DEVICES_PER_FREE_USER=2
MAX_DEVICES_PER_PAID_USER=5
REQUIRE_EMAIL_VERIFICATION=false

# --- billing ---------------------------------------------------------------
# Live payment lagne tak "mock" hi rahega, PAR mock ka test endpoint band
# rakhna zaroori hai - warna koi bhi banda apne aap ko free subscription de
# lega. MOCK_BILLING_SECRET khali = wo route exist hi nahi karta.
PAYMENT_PROVIDER=mock
MOCK_BILLING_SECRET=
PLAN_PRICE_CENTS=500
PLAN_CURRENCY=USD
PLAN_INTERVAL=month
BILLING_SUCCESS_URL=https://tubenotes.trueworks.in/billing/success
BILLING_CANCEL_URL=https://tubenotes.trueworks.in/billing/cancel

# Razorpay (India se bill karna ho to) - dashboard se lo
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_PLAN_ID=
RAZORPAY_WEBHOOK_SECRET=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# --- web app + Ollama ------------------------------------------------------
WEB_APP_ENABLED=true

# DGX par Ollama usi machine par chal raha hai. host.docker.internal use karne
# se request public internet par jaakar wapas nahi aati - seedha andar hi andar
# jati hai, isliye tez hai. Agar ye kaam na kare to niche wali line use karo.
OLLAMA_URL=http://host.docker.internal:11434
# OLLAMA_URL=https://ollama.trueworks.in
OLLAMA_MODEL=gemma2:9b
OLLAMA_INDIC_MODEL=sarvam-m-q4
OLLAMA_TIMEOUT_SECONDS=300

TRANSCRIPT_MAX_CHARS=12000

# ---- PDF ki speed ---------------------------------------------------------
# DHYAN: agar aapki purani .env me ye lines pehle se hain to WO chalti hain,
# code ke naye default nahi. Purani .env me ye teen zaroor update karo.

# Bade chunk = utne hi transcript ke liye kam round trip. 6000 chars ~1500-2000
# token hai, jo num_ctx 8192 me prompt aur poore jawab ke saath aaram se aata hai.
NOTES_CHUNK_CHARS=6000
NOTES_CHUNK_OVERLAP=400
# 0 = koi limit nahi. Lambi video poori aayegi, bas time zyada lagega.
NOTES_MAX_CHUNKS=0
NOTES_NUM_PREDICT=4096
# Ye aapke server se aage nahi ja sakta: Ollama OLLAMA_NUM_PARALLEL jitni
# requests ek saath chalata hai, baaki queue me. Aapke DGX par wo 4 hai.
NOTES_CONCURRENCY=4
NOTES_CHUNK_RETRIES=3

# Sarvam jaise reasoning model pehle ek chhupa hua <think> block likhte hain
# jise hum phenk dete hain - yaani aadha kaam bekaar. true hone par Ollama se
# use skip karne ko kehte hain. Purane Ollama build HTTP 400 dete hain; wo ek
# baar detect hokar yaad rakh liya jata hai, isliye ise ON rakhna safe hai.
OLLAMA_SKIP_THINKING=true

# Ek hi video ka transcript summary ke liye ek baar aur PDF ke liye dobara
# YouTube se aata tha - dono baar server ke IP se. Cache se doosri fetch
# bilkul khatam. 0 = cache band.
TRANSCRIPT_CACHE_TTL_SECONDS=1800
TRANSCRIPT_CACHE_MAX_ENTRIES=200

# ---- sabhi users ke beech share hone wala cache ---------------------------
# Ek video ka summary/notes ek baar banta hai; uske baad har agle user ko DB se
# turant milta hai - na YouTube, na Ollama. Naapa hua: 515 ms.
OUTPUT_CACHE_ENABLED=true
# Itne din tak jise kisi ne nahi khola, wo row cron se hat jayegi.
OUTPUT_CACHE_TTL_DAYS=180
# Itne se chhota jawab cache mat karo - wo aksar fail hua jawab hota hai.
OUTPUT_CACHE_MIN_CHARS=200
# Unlisted/private video kabhi cache nahi hoti, taki kisi ki private video ka
# summary us ajnabi ko na mile jise sirf video ID pata hai. Ye check ek extra
# request leta hai, sirf cache miss par. Check na ho paye to cache nahi karta.
CACHE_ONLY_PUBLIC_VIDEOS=true

# Server ka IP YouTube se block ho jaye to yahan proxy daalna
YOUTUBE_PROXY=

# --- transport / CORS ------------------------------------------------------
# "*" isliye theek hai: hum cookie use nahi karte (allow_credentials=False),
# auth Authorization header se hoti hai. Extension ka origin
# chrome-extension://<id> hota hai jo har install par badal sakta hai, isliye
# use list mein pin karna practical nahi.
ALLOWED_ORIGINS=*
ALLOWED_EXTENSION_IDS=

# Nginx ke peeche hain, isliye asli client IP X-Forwarded-For se lo - warna
# rate limiter ko har request Nginx se aati dikhegi aur sab ek hi bucket mein
# gir jayenge.
TRUST_PROXY_HEADERS=true

RATE_LIMIT_ENABLED=true
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_SECONDS=300
SIGNUP_RATE_LIMIT=5
SIGNUP_RATE_WINDOW_SECONDS=3600

# --- email -----------------------------------------------------------------
# "console" matlab mail sirf log mein chhapta hai. Password reset asli mail se
# bhejna ho to smtp kar do aur neeche ke fields bharo.
EMAIL_BACKEND=console
EMAIL_FROM=no-reply@tubenotes.trueworks.in
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true

BCRYPT_ROUNDS=12
